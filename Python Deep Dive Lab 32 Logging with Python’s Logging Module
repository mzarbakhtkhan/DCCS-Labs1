import logging

# Task 1: Import logging (already done)

# Task 2 & 3: Configure logging with level and format
logging.basicConfig(
    level=logging.DEBUG,  # Capture all levels
    format='%(asctime)s - %(levelname)s - %(message)s',
    datefmt='%Y-%m-%d %H:%M:%S',
    # Optional: Log to file as well
    handlers=[
        logging.FileHandler("app.log", mode='w'),
        logging.StreamHandler()  # Console output
    ]
)

print("=== Lab 32: Logging with Python’s Logging Module ===\n")

# Task 4: Log messages at different levels
logging.debug("This is a debug message - detailed diagnostic info.")
logging.info("This is an info message - things are working as expected.")
logging.warning("This is a warning message - something unexpected happened.")
logging.error("This is an error message - serious problem occurred.")
logging.critical("This is a critical message - program may not continue.")

# Task 5: Practical Application
def divide_numbers(a, b):
    """Example function demonstrating logging in error handling."""
    try:
        if b == 0:
            raise ZeroDivisionError("Cannot divide by zero")
        result = a / b
        logging.info(f"Division successful: {a} / {b} = {result}")
        return result
    except ZeroDivisionError as e:
        logging.error(f"Division by zero error: {e}")
        return None
    except Exception as e:
        logging.critical(f"Unexpected error during division: {e}")
        return None


# Demonstrate the practical function
print("\n--- Practical Application: Division Function ---")
result1 = divide_numbers(10, 2)
print(f"10 / 2 = {result1}")

result2 = divide_numbers(15, 0)
print(f"15 / 0 = {result2}")

# Additional useful example
logging.info("Starting file processing simulation...")
# Simulate a task
try:
    with open("sample_data.txt", "w") as f:
        f.write("Sample data for logging lab.")
    logging.info("File written successfully.")
except Exception as e:
    logging.error(f"File operation failed: {e}")

print("\nLogging demonstration completed!")
print("Check 'app.log' file for complete log records.")
