import argparse

# Task 4 & 5: Create parser and define arguments
parser = argparse.ArgumentParser(
    description='A simple greeting CLI application.',
    epilog='Example: python greet.py --name Alice --age 25 --greeting Hi'
)

# Positional argument (required)
parser.add_argument('name', nargs='?', default=None,
                    help='The name of the person to greet (optional)')

# Optional arguments
parser.add_argument('--age', type=int, default=None,
                    help='The age of the person (optional)')

parser.add_argument('--greeting', type=str, default='Hello',
                    help='Custom greeting word (default: Hello)')

parser.add_argument('--verbose', '-v', action='store_true',
                    help='Enable verbose output')

# Task 5: Parse arguments
args = parser.parse_args()

# Task 6: Use the parsed arguments
if args.name:
    greeting_message = f"{args.greeting}, {args.name}!"
    if args.age is not None:
        greeting_message += f" You are {args.age} years old."
    print(greeting_message)

    if args.verbose:
        print(f"[VERBOSE] Greeting generated for: {args.name}")
        print(f"[VERBOSE] Custom greeting used: {args.greeting}")
else:
    print("Hello, Stranger!")

if args.verbose and not args.name:
    print("[VERBOSE] No name provided - using default greeting.")
